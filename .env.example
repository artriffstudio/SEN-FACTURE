# ============================================================
# FACTURIM — Variables d'Environnement Supabase
# ============================================================

# 1. Authentification pour le serveur MCP Supabase (@supabase/mcp-server-supabase)
# Générez votre Personal Access Token sur : https://app.supabase.com/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_votre_token_dacces_personnel_ici

# Référence de votre projet Supabase (ex: abcdefghijklmnopqrstuvwxyz)
# Visible dans Dashboard > Project Settings > General > Reference ID
SUPABASE_PROJECT_REF=votre_project_ref_ici

# 2. Configuration Client Next.js (Supabase SDK)
# Visible dans Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique_ici

# 3. Clé Service Role (uniquement côté serveur, ne JAMAIS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete_ici
